{
  "name": "tendergrove",
  "version": "1.0.0",
  "description": "A service for making identifying distress from anecdotal evidence.",
  "main": "index.js",
  "scripts": {
    "sandbox": "ampx sandbox --once",
    "sandbox:delete": "ampx sandbox delete",
    "pwa": "pnpm --filter pwa dev",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "format": "pnpm -r format",
    "mobile:build:debug": "pnpm --filter pwa build && cd pwa && (npx cap add android 2>/dev/null || true) && npx cap sync && cd android && JAVA_HOME=$(/usr/libexec/java_home -v 21) ./gradlew assembleDebug",
    "seed:test-person": "npx tsx scripts/seed-test-person.ts",
    "codemod:arrows": "tsx scripts/convert-functions-to-arrows.ts"
  },
  "keywords": [],
  "author": "",
  "license": "All Rights Reserved",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@aws-amplify/backend": "^1.23.0",
    "@aws-amplify/backend-cli": "^1.8.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unicorn": "^71.1.0",
    "playwright": "^1.61.1",
    "sass-embedded": "^1.100.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "aws-amplify": "^6.18.0"
  }
}
